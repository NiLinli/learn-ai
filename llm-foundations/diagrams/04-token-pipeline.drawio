<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="claude-code" agent="claude-code-drawio-skill" version="24.7.17" type="device">
  <diagram name="一次 token 生成" id="token-pipeline">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="一次 token 的生成过程，以及两种「向量」的区别" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="input" value="输入文本：「苹果公司发布了」" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="440" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="① Token 化&lt;br/&gt;&lt;font color=&quot;#555555&quot; size=&quot;1&quot;&gt;文本 → token id：苹果 / 公司 / 发布 / 了&lt;/font&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="160" width="440" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="② Token Embedding（查表，固定）&lt;br/&gt;&lt;font color=&quot;#555555&quot; size=&quot;1&quot;&gt;每个 token → 3584 维向量，同一个词永远同一行&lt;/font&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="254" width="440" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="③ Transformer × 28 层&lt;br/&gt;&lt;font color=&quot;#555555&quot; size=&quot;1&quot;&gt;隐藏状态融入上下文：「苹果」变成 Apple Inc.&lt;/font&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="348" width="440" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="④ Q / K / V（注意力）&lt;br/&gt;&lt;font color=&quot;#555555&quot; size=&quot;1&quot;&gt;Q 我在找什么 · K 我的标签 · V 我的内容（GQA 只存 4 份）&lt;/font&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="442" width="440" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="⑤ Logits&lt;br/&gt;&lt;font color=&quot;#555555&quot; size=&quot;1&quot;&gt;词表 152K 维分数：新 9.2 · 产 7.8 · i 6.5 ...&lt;/font&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="536" width="440" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="⑥ 采样&lt;br/&gt;&lt;font color=&quot;#555555&quot; size=&quot;1&quot;&gt;按 temperature / top_p 选出一个 token&lt;/font&gt;" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="630" width="440" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="output" value="输出：「新」→ 追加到序列，作为下一轮的输入" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="724" width="440" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="e-in-s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="input" target="s1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="144"/></Array></mxGeometry>
