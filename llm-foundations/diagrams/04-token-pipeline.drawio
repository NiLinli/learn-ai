        <mxCell id="note" value="注意：以上都是单 token 的视角。用户看到的一段话，是这个循环重复 N 次的结果" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=12" vertex="1" parent="1">
          <mxGeometry x="100" y="830" width="440" height="64" as="geometry"/>
