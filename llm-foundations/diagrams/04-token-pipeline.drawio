        <mxCell id="e-s5-s6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="614"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e-s6-out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="s6" target="output">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="708"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e-loop" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;fontSize=11" edge="1" parent="1" source="output" target="s1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="60" y="752"/>
              <mxPoint x="60" y="191"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="vec" value="两种「向量」别混" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;fontSize=15;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="520" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="inner" value="内部向量（模型里）&lt;br/&gt;&lt;font color=&quot;#555555&quot; size=&quot;1&quot;&gt;权重表 + 隐藏状态，服务于「预测下一个 token」&lt;/font&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="480" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="outer" value="外部向量（RAG 用）&lt;br/&gt;&lt;font color=&quot;#555555&quot; size=&quot;1&quot;&gt;embedding 模型把句子映射成向量，服务于「检索」&lt;/font&gt;" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="640" y="220" width="480" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="same" value="相同：都是数字数组；语义越近，向量距离越小&lt;br/&gt;不同：内部向量参与生成，外部向量参与查找" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=12" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="480" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="analogy" value="vector(国王) − vector(男人) + vector(女人) ≈ vector(女王)" style="text;html=1;fontSize=11;align=center;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="620" y="400" width="520" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="rag" value="外部向量的流程" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#82b366;verticalAlign=top;fontSize=14;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="620" y="490" width="520" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="文档 → 切片" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="640" y="530" width="220" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="每段 → 向量" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="900" y="530" width="220" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="存入向量库" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="900" y="600" width="220" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="查询 → 同一个 embedding 模型 → 向量" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="220" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="r5" value="余弦相似度找最近的几段" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="640" y="675" width="480" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="r6" value="把这几段原文塞进 LLM 的 prompt" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="640" y="735" width="480" height="44" as="geometry"/>
        </mxCell>
