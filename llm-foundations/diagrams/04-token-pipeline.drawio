          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="727"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="temp" value="temperature 速记：T=0 永远选最高分（工具 / JSON 用 0~0.3）；T 越高越随机（创作 0.9+）" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12" vertex="1" parent="1">
          <mxGeometry x="620" y="820" width="520" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="loop-note" value="循环：每生成一个 token 重复一次" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="300" height="28" as="geometry"/>
